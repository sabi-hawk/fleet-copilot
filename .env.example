# Copy to .env (git-ignored). Only needed for the Claude reasoner; everything else runs offline.
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown)
# FLEET_COPILOT_MODEL=claude-opus-5-5
# FLEET_COPILOT_EFFORT=high            # low | medium | high | xhigh | max | none (omit the parameter)
# FLEET_COPILOT_REFUSAL_FALLBACK=on    # server-side refusal fallback on supported models
# FLEET_COPILOT_DATASET=data/device-telemetry-dataset.ndjson
# FLEET_COPILOT_HOME=var               # audit log + action outbox location
