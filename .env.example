# Copy to .env (git-ignored). Only needed for the LLM reasoners; everything else runs offline.
# --reasoner auto picks Claude if ANTHROPIC_API_KEY is set, else Gemini if GEMINI_API_KEY is set, else the offline reasoner.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional overrides (defaults shown)
# FLEET_COPILOT_MODEL=claude-opus-5-5
# FLEET_COPILOT_EFFORT=high            # Claude: low | medium | high | xhigh | max | none (omit the parameter)
# FLEET_COPILOT_REFUSAL_FALLBACK=on    # Claude: server-side refusal fallback on supported models
# FLEET_COPILOT_GEMINI_MODEL=gemini-3.5-flash
# FLEET_COPILOT_GEMINI_THINKING=LOW    # Gemini: MINIMAL | LOW | MEDIUM | HIGH | none
# FLEET_COPILOT_LLM_TIMEOUT=120        # seconds per LLM request (timeouts / 429 / 5xx are retried)
# FLEET_COPILOT_LLM_MIN_INTERVAL=0     # seconds between LLM calls (free-tier pacing)
# FLEET_COPILOT_DATASET=data/device-telemetry-dataset.ndjson
# FLEET_COPILOT_HOME=var               # audit log + action outbox location
